APP_NAME=matchmaking
APP_ENV=prod

GRPC_PORT=50051

DATABASE_URL=postgresql://postgres:postgres@pgbouncer:6432/matchmaking
DATABASE_DIRECT_URL=postgresql://postgres:postgres@postgres:5432/matchmaking

PG_BOSS_MAX=5
PG_BOSS_MAINTENANCE_INTERVAL_SECONDS=60
PG_BOSS_APPLICATION_NAME=matchmaking-pg-boss

KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=matchmaking-client
KAFKA_GROUP_ID=matchmaking-service

MESSAGE_PRODUCER_TOPIC_MATCHMAKING_MATCHED=matchmaking.matched
